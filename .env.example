# Vorlage. Kopieren nach .env und ausfüllen.
# .env ist in .gitignore und darf NIE committet werden.
#
#   cp .env.example .env
#
# Auf dem Zielrechner wird diese Datei beim Deploy separat eingespeist,
# nicht aus dem Repo geholt.

# Telegram — Bot bei @BotFather anlegen (/newbot)
TELEGRAM_BOT_TOKEN=
# Eigene Chat-ID; ermittelt bin/telegram-setup.sh
TELEGRAM_CHAT_ID=

# ALLOWLIST — wer den Bot bedienen darf. Kommagetrennt.
# Telegram-Bots sind oeffentlich adressierbar, jeder kann ihnen schreiben.
# Ohne diese Pruefung waere die Bridge eine offene Fernsteuerung des
# Orchestrators. Details in bridge/README.md.
# Im privaten Einzelchat ist die User-ID identisch mit der Chat-ID.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# OpenCode Go — Abo, 10 $/Monat. Deckt classifier, cheap und reviewer.
# Endpunkt: https://opencode.ai/zen/go/v1 (OpenAI-kompatibel)
# WICHTIG: Dieses Kontingent ist dem Klassifizierer vorbehalten. Keine
# schweren Rollen dorthin legen, sonst faellt der Eingang zuerst aus.
OPENCODE_API_KEY=

# OpenRouter — media (Grok Imagine) UND der metrierte Topf fuer Arbeit.
# Zen führt ausschliesslich Coding-Modelle, keine Bild-/Videoerzeugung.
# Ausgabenlimit im Konto setzen: zweite Bremse neben dem Budgetwaechter,
# und die einzige, die auch bei einem Fehler darin greift.
#
# Zweiter Zweck: Er ist der einzige Weg, ein Modell aus dem Go-Katalog
# ARBEITEN zu lassen, ohne das Klassifizierer-Kontingent anzufassen
# (Leitsatz 2 in config/models.yaml sperrt den Topf, nicht das Modell).
# Preis deepseek-v4-flash-0731: 0,14 $/M ein, 0,28 $/M aus.
# Leer lassen ist erlaubt — bin/omp-configure.sh laesst den Provider dann weg.
OPENROUTER_API_KEY=

# xAI API — OPTIONAL und derzeit NICHT gesetzt. Nur fuer Bild-/Videoerzeugung
# (Grok Imagine). Geprueft 2026-08-19: Das xAI-ABO gibt das NICHT her, der
# Modellkatalog unter xai-oauth enthaelt kein Bildmodell. Grok Imagine ist ein
# eigenes Produkt mit Schluessel von console.x.ai und Abrechnung pro Stueck:
# 0,04 $/Bild, 0,080 $/Videosekunde. Ein Sechs-Sekunden-Video kostet damit
# 0,48 $ — mehr als ein ganzer Opus-Lauf auf der L-Stufe. Gehoert unter den
# Budgetdeckel, wenn es je gebraucht wird.
XAI_API_KEY=

# RunInfra — OPTIONAL, Alternative zu OpenRouter fuer denselben Zweck.
# Endpunkt https://api.runinfra.ai/v1 (OpenAI-kompatibel), Modell
# deepseek-v4-flash. 0,13 $/M ein, 0,27 $/M aus — praktisch derselbe Preis
# wie OpenRouter. Der Unterschied liegt in zwei Punkten, die noch zu pruefen
# sind: beworbener Durchsatz (200+ tok/s) und die Zusage, Prompts weder zu
# speichern noch zum Training zu verwenden.
RUNINFRA_API_KEY=

# Die reviewer-Rolle läuft über ein vorhandenes Abo (Claude Code bzw. Codex),
# nicht über einen API-Schlüssel — die Harnesses authentifizieren selbst.
# Deshalb steht hier nichts.
